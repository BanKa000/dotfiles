{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/hotkeys",
        "custom/tv-display",
        "custom/tv-audio",
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "hyprland/language",
        "battery",
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b  %H:%M}",
        "locale": "ru_RU.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#7aa2f7'><b>{}</b></span>"
            }
        }
    },
    "custom/hotkeys": {
        "exec": "~/.config/waybar/scripts/hotkeys.py",
        "return-type": "json",
        "interval": 30,
        "tooltip": true
    },
    "custom/tv-display": {
        "exec": "~/.config/waybar/scripts/tv.py display",
        "on-click": "~/.config/waybar/scripts/tv.py display toggle",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },
    "custom/tv-audio": {
        "exec": "~/.config/waybar/scripts/tv.py audio",
        "on-click": "~/.config/waybar/scripts/tv.py audio toggle",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 3
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 eth",
        "format-disconnected": "󰤭 offline",
        "tooltip-format": "{ifname} {ipaddr}  ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "on-click": "kitty -e nmtui"
    },
    "hyprland/language": {
        "format-en": " en",
        "format-ru": " ru"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-full": " full",
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "tray": {
        "icon-size": 13,
        "spacing": 6
    },
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10
}