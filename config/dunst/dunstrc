# Tokyo Night, matches waybar
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (10, 44)
    width = 320
    height = (0, 200)
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 10
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    icon_theme = breeze-dark
    enable_recursive_icon_lookup = true
    max_icon_size = 40
    separator_height = 0
    background = "#1a1b26ee"
    foreground = "#a9b1d6"
    frame_color = "#7aa2f7"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    frame_color = "#565f89"
    timeout = 4

[urgency_normal]
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    frame_color = "#f7768e"
    timeout = 0
